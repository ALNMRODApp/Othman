{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated merchant account profile for CXT - othman.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Merchant store configuration, business sector, logo, and invoice customization.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "businessType": {
          "type": "string",
          "enum": ["mobile_shop", "shopping_mall", "cooperative", "grocery", "services", "custom"]
        },
        "customBusinessLabel": {
          "type": "string",
          "maxLength": 120
        },
        "logoDataUrl": {
          "type": "string",
          "maxLength": 300000
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "taxNumber": {
          "type": "string",
          "maxLength": 60
        },
        "currency": {
          "type": "string",
          "enum": ["IQD", "USD", "SAR", "AED", "KWD", "EGP"]
        },
        "taxRate": {
          "type": "number"
        },
        "invoiceFooterNote": {
          "type": "string",
          "maxLength": 300
        },
        "accentColor": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "templateStyle": {
          "type": "string",
          "enum": ["classic", "modern", "thermal", "executive", "minimal"]
        },
        "invoiceFont": {
          "type": "string",
          "enum": ["cairo", "tajawal", "amiri", "ibm_plex"]
        },
        "customFields": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "storeName",
        "businessType",
        "currency",
        "taxRate",
        "accentColor",
        "templateStyle",
        "createdAt",
        "updatedAt"
      ]
    },
    "Client": {
      "title": "Client",
      "description": "Customer record managed inside the merchant CRM.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "createdAt", "updatedAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Electronic invoice document with bounded line items and totals.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "clientId": {
          "type": "string",
          "maxLength": 128
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "clientPhone": {
          "type": "string",
          "maxLength": 40
        },
        "businessType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "issueDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "dueDate": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending", "draft"]
        },
        "currency": {
          "type": "string",
          "enum": ["IQD", "USD", "SAR", "AED", "KWD", "EGP"]
        },
        "taxRate": {
          "type": "number"
        },
        "discountAmount": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "taxAmount": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "items": {
          "type": "array"
        },
        "customFields": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "invoiceNumber",
        "clientName",
        "businessType",
        "issueDate",
        "status",
        "currency",
        "taxRate",
        "discountAmount",
        "subtotal",
        "taxAmount",
        "total",
        "items",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Authenticated merchant profile isolated per user."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/StoreSettings"
      },
      "description": "Merchant store identity, logo, and invoice template settings."
    },
    "/users/{userId}/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/Client"
      },
      "description": "Merchant customer records."
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": {
        "$ref": "#/entities/Invoice"
      },
      "description": "Merchant electronic invoices."
    }
  }
}
